;UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU

[sbawe32.mdi]

;
;Selected by default if AUTOEXEC contains AWEUTIL string
;
;Default I/O parms from driver
;

.A AWEUTIL
.IOD

.NAME
Creative Labs AWE-32(TM) General MIDI

