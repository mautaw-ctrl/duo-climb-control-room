;UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU

[ultra.mdi]

;
;Selected by default if environment contains ULTRASND variable
;
