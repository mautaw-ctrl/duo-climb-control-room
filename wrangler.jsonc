{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duo-climb-control-room",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/prepare-win98.mjs"
  }
}
